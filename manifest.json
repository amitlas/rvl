{
  "manifest_version": 3,
  "name": "rvl",
  "description": "Select a multiple-choice question and see the correct option's letter in a small box. Works with Chrome's built-in AI or a free API key.",
  "version": "1.0.2",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "commands": {
    "rvl": {
      "suggested_key": {
        "default": "Ctrl+Z",
        "mac": "MacCtrl+Z"
      },
      "description": "Reveal the answer to the selected question"
    }
  },
  "action": {
    "default_title": "rvl settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
